# Copy to .env and adjust
DJANGO_SECRET_KEY=change-me-in-production-use-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,https://yourdomain.com

POSTGRES_DB=portfolio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Optional admin auto-create
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=strong-password-here

# Contact form email notifications (Gmail SMTP + app password)
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=xxxx-xxxx-xxxx-xxxx
CONTACT_RECIPIENT_EMAIL=you@gmail.com
